# Auto-generated defaults for local Docker development.
# Copy to backend/.env (or let docker-entrypoint.sh generate it).

APP_ENV=dev
APP_DEBUG=1

# Database (Docker compose sets DATABASE_URL, these are fallbacks)
POSTGRES_DB=techreserve
POSTGRES_USER=techreserve_user
POSTGRES_PASSWORD=techreserve_pass
POSTGRES_HOST=database
DATABASE_URL=postgresql://techreserve_user:techreserve_pass@database:5432/techreserve?serverVersion=15&charset=utf8

# Clerk (set real values in your root .env / compose env)
CLERK_SECRET_KEY=
CLERK_API_BASE_URL=https://api.clerk.com
CLERK_JWT_ISSUER=
DEFAULT_URI=http://localhost:8000

