# === PostgreSQL Database ===
POSTGRES_DB=techreserve
POSTGRES_USER=techreserve_user
POSTGRES_PASSWORD=techreserve_pass
DATABASE_URL=postgresql://techreserve_user:techreserve_pass@database:5432/techreserve?serverVersion=15&charset=utf8

# === PGAdmin ===
