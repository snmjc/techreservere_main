# === Ports ===
FRONTEND_EXTERNAL_PORT=5173
BACKEND_EXTERNAL_PORT=8000
PGADMIN_EXTERNAL_PORT=5050
POSTGRES_EXTERNAL_PORT=49674

# === PostgreSQL Database ===
POSTGRES_DB=techreserve
POSTGRES_USER=techreserve_user
POSTGRES_PASSWORD=techreserve_pass
DATABASE_URL=postgresql://techreserve_user:techreserve_pass@database:5432/techreserve?serverVersion=15&charset=utf8

# === PGAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@techreserve.com
PGADMIN_DEFAULT_PASSWORD=admin

# === App URLs ===
VITE_API_BASE_URL=http://localhost:8000/
DEFAULT_URI=http://localhost:8000/
FRONTEND_URL=http://localhost:5173/
DEV_FRONTEND_URL=http://localhost:5173/
VITE_FRONTEND_URL=http://localhost:5173/
VITE_DEV_FRONTEND_URL=http://localhost:5173/

# === Clerk Authentication (Development) ===
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_dev_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_dev_secret_key_here
CLERK_JWT_ISSUER=https://your-dev-instance.clerk.accounts.dev
# Optional if you test Clerk webhooks locally.
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_API_BASE_URL=https://api.clerk.com/
VITE_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
VITE_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# === Mail / Messenger ===
MAILER_DSN=null://null
MAILER_FROM=onboarding@resend.dev
MESSENGER_TRANSPORT_DSN=sync://
