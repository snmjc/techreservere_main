FROM node:20-bullseye-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_FRONTEND_URL=https://techreserve.farahkenawy.codes/
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY}
ENV VITE_FRONTEND_URL=${VITE_FRONTEND_URL}

RUN if echo "$VITE_FRONTEND_URL" | grep -q "techreserve.farahkenawy.codes" \
    && ! echo "$VITE_CLERK_PUBLISHABLE_KEY" | grep -q "^pk_live_"; then \
      echo "Production builds for techreserve.farahkenawy.codes require a Clerk pk_live_ publishable key."; \
      exit 1; \
    fi

RUN if echo "$VITE_FRONTEND_URL" | grep -q "techreserve.farahkenawy.codes"; then \
      encoded_key="${VITE_CLERK_PUBLISHABLE_KEY#pk_live_}"; \
      decoded_domain="$(printf '%s' "$encoded_key" | base64 -d 2>/dev/null || true)"; \
      if [ "$decoded_domain" != "clerk.techreserve.farahkenawy.codes$" ]; then \
        echo "Production builds for techreserve.farahkenawy.codes require a Clerk publishable key for clerk.techreserve.farahkenawy.codes."; \
        exit 1; \
      fi; \
    fi

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
