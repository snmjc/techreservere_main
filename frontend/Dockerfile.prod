FROM node:20-bookworm-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_FRONTEND_URL=https://techreserve.farahkenawy.codes/
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY}
ENV VITE_FRONTEND_URL=${VITE_FRONTEND_URL}

RUN if [ -z "$VITE_CLERK_PUBLISHABLE_KEY" ] \
    || echo "$VITE_CLERK_PUBLISHABLE_KEY" | grep -q "^pk_test_your_clerk_key_here$"; then \
      echo "Production builds require a real VITE_CLERK_PUBLISHABLE_KEY value."; \
      exit 1; \
    fi

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
